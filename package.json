{
  "name": "svws-photo-matcher",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "serve": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "build": "vite build",
    "preview": "node backend/server.js",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5"
  },
  "productName": "SVWS Foto-Matcher",
  "description": "Schuelerfotos SVWS zuordnen und hochladen",
  "main": "desktop/src/main.js",
  "build": {
    "appId": "de.jwae.svws-photo-matcher",
    "productName": "SVWS Foto-Matcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "backend/**/*.js",
      "!backend/**/*.test.js",
      "lib/**/*.js",
      "desktop/src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SVWS-Foto-Matcher-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "SVWS-Foto-Matcher-${version}-Portable.${ext}"
    }
  }
}
